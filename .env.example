# InsightPilot Configuration
# Copy this file to .env and fill in your values.

# === Server ===
PORT=3000
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
STATIC_DIR=                          # Path to built Next.js frontend (default: frontend/out)

# === Database (Supabase PostgreSQL) ===
# Required for persistence across restarts. Falls back to in-memory if not set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_key
SUPABASE_DB_PASSWORD=your_db_password

# === LLM / OpenRouter ===
# Optional — falls back to deterministic analyzer if not configured.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_TEMPERATURE=1.0
OPENROUTER_TIMEOUT_SEC=120

# === Python Visualization ===
PLOT_RETENTION_HOURS=24             # Hours to keep generated plot artifacts; 0 disables cleanup

# === Data Processing ===
QUERY_TIMEOUT_SEC=30                # Timeout for DuckDB arbitrary SQL queries
REFRESH_INTERVAL_MIN=15             # Interval for live-db dataset refresh
UPLOAD_DIR=                         # Upload directory (default: <project-root>/uploads)

# === Email (Scheduled Reports & Alerts) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM=alerts@example.com        # Defaults to SMTP_USER if not set
ALERT_COOLDOWN_MIN=60               # Minimum minutes between alerts for same rule
